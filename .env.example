# Nutrient Python SDK license key. Empty = evaluation mode.
NUTRIENT_LICENSE_KEY=
# Nutrient Web SDK license key, served to the browser. Empty = evaluation mode.
NUTRIENT_WEB_SDK_LICENSE_KEY=
# OpenAI-compatible endpoint and vision model that read scanned pages and pictures (Ollama by default).
VISION_BASE_URL=http://localhost:11434/v1
VISION_MODEL=qwen2.5vl:7b
# API key of that endpoint. Leave empty for Ollama.
VISION_API_KEY=
# Seconds to wait for one answer of the vision model.
VISION_TIMEOUT=600
# Resolution of the page images sent to the vision model.
RENDER_DPI=150
# Sample documents, and the folder for results and uploads.
DOCUMENTS_FOLDER=samples/documents
OUTPUT_FOLDER=output
# Address of the web page.
HOST=127.0.0.1
PORT=4730
